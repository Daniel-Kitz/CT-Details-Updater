{
  "name": "@ct-details-updater/songstats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vue-tsc --noEmit -p tsconfig.web.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.server.json",
    "dev": "node scripts/dev.js",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@ct-details-updater/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.6.1",
    "vue": "^3.5.18",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.6"
  }
}
