CHURCHTOOLS_BASE_URL=https://deine-gemeinde.church.tools
CHURCHTOOLS_LOGIN_TOKEN=login-token-des-technischen-benutzers
SESSION_SECRET=mit-openssl-rand-hex-32-erzeugen

# true hinter einem HTTPS-Reverse-Proxy, false bei direktem HTTP-Test
COOKIE_SECURE=true

# Optionale Feineinstellungen
LOG_LEVEL=info
AGENDA_CONCURRENCY=5
MONTHLY_CACHE_CHECK_MINUTES=60
