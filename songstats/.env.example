# ChurchTools-Instanz, gegen die sich Nutzer:innen anmelden.
# Ohne Slash am Ende, ohne /api.
CHURCHTOOLS_BASE_URL=https://cbgmayen.church.tools/

# Server
PORT=5175
HOST=0.0.0.0
LOG_LEVEL=info

# Sitzungen und Cache
SESSION_TTL_HOURS=8
CACHE_TTL_MINUTES=15
MAX_RANGE_MONTHS=24
AGENDA_CONCURRENCY=5

# Monatlicher, persistenter 6-Monats-Cache (nur Sonntage).
# Login-Token eines technischen Benutzers mit Leserechten auf Events/Agenden.
CHURCHTOOLS_LOGIN_TOKEN=
MONTHLY_CACHE_FILE=.cache/songstats-cache.json
MONTHLY_CACHE_CHECK_MINUTES=60

# Cookies
# In lokaler HTTP-Umgebung auf false setzen. Produktiv: true.
COOKIE_SECURE=true
COOKIE_NAME=songstats_sid

# Wird zur Ableitung des Session-Cookie-Signaturschlüssels genutzt.
# Mindestens 32 zufällige Zeichen.
SESSION_SECRET=bitte-durch-langen-zufallswert-ersetzen-mind-32-zeichen
